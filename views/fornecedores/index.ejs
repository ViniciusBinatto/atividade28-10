<%- include('../partials/header') %>
<%- include('../partials/nav') %>

<div class="container mt-5">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h1>Fornecedores</h1>

            <p class="text-muted">
                Lista de Fornecedores cadastrados
            </p>

        </div>

        <a
            href="/fornecedores/cadastro"
            class="btn btn-primary">

            + Novo Fornecedor

        </a>

    </div>


    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover
                              align-middle">
                    <thead class="table-dark">
                        <tr>

                            <th>ID</th>
                            <th>Razão Social</th>
                            <th>CNPJ</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Cidade</th>
                            <th class="text-center">Ações</th>
                        </tr>

                    </thead>

                    <tbody>
                        <% fornecedores.forEach(mostrar => { %> 
                            <tr>
                                <td><%= mostrar.id %></td>
                                <td><%= mostrar.razaoSocial %></td>
                                <td><%= mostrar.cnpj %></td>
                                <td><%= mostrar.email %></td>
                                <td><%= mostrar.telefone %></td>
                                <td><%= mostrar.cidade %></td>
                                <td>
                                    <a class="btn btn-success btn-sm" href="/fornecedores/editar/<%= mostrar.id %>">Editar</a>
                                    <a class="btn btn-warning btn-sm" href="/fornecedores/excluir/<%= mostrar.id %>" onclick="return confirm('Deseja exluir este fornecedor?')">Excluir</a>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
<%- include('../partials/footer') %>
