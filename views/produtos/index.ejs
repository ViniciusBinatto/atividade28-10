<%- include('../partials/header') %>
<%- include('../partials/nav') %>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Produtos</h1>
            <p class="text-muted">Lista de Produtos cadastrados</p>
        </div>
        <a href="/produtos/cadastro" class="btn btn-primary">+ Novo Produto</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th>Preço</th>
                            <th>Estoque</th>
                            <th>Categoria</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% produtos.forEach(mostrar => { %> 
                            <tr>
                                <td><%= mostrar.id %></td>
                                <td><%= mostrar.nome %></td>
                                <td><%= mostrar.descricao %></td>
                                <td>R$ <%= mostrar.preco %></td>
                                <td><%= mostrar.estoque %></td>
                                <td><%= mostrar.categoria %></td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="/produtos/editar/<%= mostrar.id %>" class="btn btn-success btn-sm">Editar</a>
                                        <a href="/produtos/excluir/<%= mostrar.id %>" class="btn btn-warning btn-sm" onclick="return confirm('Tem certeza que deseja excluir este produto?')">Excluir</a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>